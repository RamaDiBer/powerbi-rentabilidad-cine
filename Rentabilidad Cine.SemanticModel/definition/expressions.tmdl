	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Puntuaciones_Alternativas =
		let
		    Origen = Puntuaciones_Revision,
		
		    // Misma clave, pero cambiando comas y guiones por espacios.
		    ConClaveAlternativa = Table.AddColumn(
		        Origen,
		        "Clave_Alternativa",
		        each
		            if [Título] = null or [Año de estreno] = null then
		                null
		            else
		                let
		                    Titulo = Text.Upper(Text.Trim([Título]), "es-ES"),
		                    Separadores = Text.Replace(
		                        Text.Replace(Titulo, ",", " "),
		                        "-", " "
		                    ),
		                    SinEspaciosExtra = Text.Combine(
		                        List.Select(Text.Split(Separadores, " "), each _ <> ""),
		                        " "
		                    )
		                in
		                    SinEspaciosExtra & "|" &
		                    Text.From([Año de estreno], "en-US"),
		        type text
		    )
		in
		    ConClaveAlternativa
	lineageTag: 9a74a8cc-3f71-43c0-8976-951e8102d4c9
	queryGroup: '2. Preparación'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Mapa_Puntuaciones_Alternativas =
		let
		    Origen = Puntuaciones_Alternativas,
		
		    Claves = Table.SelectColumns(
		        Origen,
		        {"Clave_Alternativa", "Clave_Busqueda"}
		    ),
		
		    SinNulos = Table.SelectRows(
		        Claves,
		        each [Clave_Alternativa] <> null
		            and [Clave_Busqueda] <> null
		    ),
		
		    ParesUnicos = Table.Distinct(SinNulos),
		
		    Agrupadas = Table.Group(
		        ParesUnicos,
		        {"Clave_Alternativa"},
		        {
		            {"Cantidad_Claves", each Table.RowCount(_), Int64.Type},
		            {"Detalle", each _, type table}
		        }
		    ),
		
		    SinAmbiguedad = Table.SelectRows(
		        Agrupadas,
		        each [Cantidad_Claves] = 1
		    ),
		
		    Expandida = Table.ExpandTableColumn(
		        SinAmbiguedad,
		        "Detalle",
		        {"Clave_Busqueda"},
		        {"Clave_Puntuacion_Original"}
		    ),
		
		    Resultado = Table.RemoveColumns(
		        Expandida,
		        {"Cantidad_Claves"}
		    )
		in
		    Resultado
	lineageTag: 6a96ca64-ad09-4aef-83f2-619094863e30
	queryGroup: '2. Preparación'

