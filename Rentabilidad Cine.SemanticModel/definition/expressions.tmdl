/// Carpeta con las fuentes (Excel/CSV). Cambiarla si el proyecto está en otra ruta en la otra PC.
expression Carpeta_Datos = "C:\CarpetaProyectos\PowerBi Cine\Carpeta_Datos\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: da49b1ca-f771-4ae1-89d3-a8f75298f781
	queryGroup: '0. Parámetros'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Text

expression Peliculas_Revision = ```
		let
		    Ruta = Text.TrimEnd(Carpeta_Datos, "\") & "\The_movies.xlsx",
		
		    Origen = Excel.Workbook(File.Contents(Ruta), null, true),
		    Hoja = Origen{[Item="base_the_movies", Kind="Sheet"]}[Data],
		
		    // La primera fila contiene los encabezados originales.
		    SinEncabezado = Table.Skip(Hoja, 1),
		
		    // Conservamos la fila original para poder revisar cada cambio.
		    TextoOriginal = Table.RenameColumns(
		        Table.SelectColumns(SinEncabezado, {"Column1"}),
		        {{"Column1", "Registro_original"}}
		    ),
		
		    ConFilaOrigen = Table.AddIndexColumn(
		        TextoOriginal,
		        "Fila_Excel",
		        2,
		        1,
		        Int64.Type
		    ),
		
		    // El archivo se guardó como UTF-8 pero se leyó como Windows-1252,
		    // por eso aparece "PelÃ­cula" en lugar de "Película".
		    // Se repara cada fila completa una sola vez, antes de separar campos.
		    RepararTexto = (texto as nullable text) as nullable text =>
		        if texto = null or Text.Remove(texto, {" ".."~"}) = "" then
		            texto
		        else
		            let
		                Convertir = (codificacion as number) as nullable text =>
		                    try
		                        Text.FromBinary(
		                            Text.ToBinary(texto, codificacion),
		                            65001
		                        )
		                    otherwise
		                        null,
		
		                // Válida si no quedan caracteres de reemplazo
		                // y el texto se acortó (dos bytes pasan a ser una letra).
		                EsValido = (candidato as nullable text) as logical =>
		                    candidato <> null
		                        and not Text.Contains(candidato, Character.FromNumber(65533))
		                        and Text.Length(candidato) < Text.Length(texto),
		
		                Con1252 = Convertir(1252),
		                ConLatin1 = Convertir(28591)
		            in
		                if EsValido(Con1252) then Con1252
		                else if EsValido(ConLatin1) then ConLatin1
		                else texto,
		
		    SepararCSV = Splitter.SplitTextByDelimiter(
		        ",",
		        QuoteStyle.Csv
		    ),
		
		    ConPartes = Table.AddColumn(
		        ConFilaOrigen,
		        "Partes",
		        each
		            if [Registro_original] = null then
		                {}
		            else
		                SepararCSV(RepararTexto(Text.From([Registro_original]))),
		        type list
		    ),
		
		    ConCantidad = Table.AddColumn(
		        ConPartes,
		        "Campos_detectados",
		        each List.Count([Partes]),
		        Int64.Type
		    ),
		
		    Nombres = {
		        "Título",
		        "Año de estreno",
		        "Género",
		        "Subgénero",
		        "Presupuesto_usd",
		        "Ingresos_usd",
		        "Director",
		        "Actores_principales",
		        "Estudios cinematográficos",
		        "Pósters"
		    },
		
		    // En este archivo, los nueve campos finales siguen al título.
		    // Si el título tiene comas, reunimos sus fragmentos.
		    Reconstruccion = Table.AddColumn(
		        ConCantidad,
		        "Datos",
		        each
		            let
		                Partes = [Partes],
		                Cantidad = [Campos_detectados],
		                Valores =
		                    if Cantidad >= 10 then
		                        {
		                            Text.Combine(
		                                List.FirstN(Partes, Cantidad - 9),
		                                ","
		                            )
		                        }
		                        & List.LastN(Partes, 9)
		                    else
		                        List.Repeat({null}, 10)
		            in
		                Record.FromList(Valores, Nombres),
		        type record
		    ),
		
		    Expandida = Table.ExpandRecordColumn(
		        Reconstruccion,
		        "Datos",
		        Nombres,
		        Nombres
		    ),
		
		    SinListaAuxiliar = Table.RemoveColumns(
		        Expandida,
		        {"Partes"}
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        SinListaAuxiliar,
		        {
		            {"Título", type text},
		            {"Año de estreno", Int64.Type},
		            {"Género", type text},
		            {"Subgénero", type text},
		            {"Presupuesto_usd", Currency.Type},
		            {"Ingresos_usd", Currency.Type},
		            {"Director", type text},
		            {"Actores_principales", type text},
		            {"Estudios cinematográficos", type text},
		            {"Pósters", type text}
		        },
		        "en-US"
		    ),
		
		    ConEstado = Table.AddColumn(
		        Tipos,
		        "Estado_estructura",
		        each
		            if [Campos_detectados] < 10 then
		                "REVISAR: faltan campos"
		            else if [Campos_detectados] > 10 then
		                "Título reconstruido: verificar"
		            else
		                "10 campos",
		        type text
		    ),
		
		    Resultado = Table.ReorderColumns(
		        ConEstado,
		        {"Fila_Excel"}
		        & Nombres
		        & {
		            "Campos_detectados",
		            "Estado_estructura",
		            "Registro_original"
		        }
		    )
		in
		    Resultado
		
		```
	lineageTag: 8c12f451-789b-4e05-ac11-ff46f7fdad61
	queryGroup: '1. Fuentes'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Puntuaciones_Revision =
		let
		    Origen = Excel.Workbook(
		        File.Contents(
		            Text.TrimEnd(Carpeta_Datos, "\") & "\Puntajes_con_Calificaciones_y_Criticas.xlsx"
		        ),
		        null,
		        true
		    ),
		
		    Hoja = Origen{[Item="Sheet1", Kind="Sheet"]}[Data],
		
		    Encabezados = Table.PromoteHeaders(
		        Hoja,
		        [PromoteAllScalars=true]
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        Encabezados,
		        {
		            {"Título", type text},
		            {"Año de estreno", Int64.Type},
		            {"Calificacion_TMDb", type number},
		            {"Total_Votos", Int64.Type},
		            {"Popularidad", type number},
		            {"Cantidad_Criticas", Int64.Type},
		            {"Criticas_Destacadas", type text}
		        }
		    ),
		
		    ConTituloNormalizado = Table.AddColumn(
		        Tipos,
		        "Titulo_Normalizado",
		        each
		            if [Título] = null then
		                null
		            else
		                Text.Upper(
		                    Text.Trim(Text.Clean([Título])),
		                    "es-ES"
		                ),
		        type text
		    ),
		
		    ConClave = Table.AddColumn(
		        ConTituloNormalizado,
		        "Clave_Busqueda",
		        each
		            if [Titulo_Normalizado] = null
		                or [Año de estreno] = null then
		                null
		            else
		                [Titulo_Normalizado]
		                & "|"
		                & Text.From([Año de estreno], "en-US"),
		        type text
		    )
		in
		    ConClave
	lineageTag: 9e9e6495-87ad-459f-b1a5-f9e856a77c39
