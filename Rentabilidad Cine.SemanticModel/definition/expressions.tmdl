expression Control_Claves_Alternativas =
		let
		    Origen = Puntuaciones_Alternativas,
		
		    ConClave = Table.SelectRows(
		        Origen,
		        each [Clave_Alternativa] <> null
		    ),
		
		    Agrupadas = Table.Group(
		        ConClave,
		        {"Clave_Alternativa"},
		        {
		            {
		                "Cantidad_Claves_Originales",
		                each List.Count(List.Distinct([Clave_Busqueda])),
		                Int64.Type
		            },
		            {
		                "Claves_Originales",
		                each Text.Combine(
		                    List.Distinct([Clave_Busqueda]),
		                    " / "
		                ),
		                type text
		            }
		        }
		    ),
		
		    Ambiguas = Table.SelectRows(
		        Agrupadas,
		        each [Cantidad_Claves_Originales] > 1
		    )
		in
		    Ambiguas
	lineageTag: daba6baf-8d2b-43bd-a204-680683086a2a
	queryGroup: '4. Controles'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Control_Candidatas =
		let
		    Origen = Revision_Candidatas_Puntuaciones,
		
		    Resumen = Table.Group(
		        Origen,
		        {"Estado_Candidata"},
		        {
		            {
		                "Cantidad_Peliculas",
		                each Table.RowCount(_),
		                Int64.Type
		            }
		        }
		    )
		in
		    Resumen
	lineageTag: 8181e728-89f5-4f63-b54a-4d3c7e05f4ed
