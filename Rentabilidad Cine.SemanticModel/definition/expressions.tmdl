	annotation PBI_ResultType = Table

expression Geografia_Preparada =
		let
		    Origen = Geografia_Revision,
		
		    Columnas = Table.SelectColumns(
		        Origen,
		        {
		            "Clave_Busqueda",
		            "Paises_Produccion",
		            "Codigos_Pais_ISO"
		        }
		    ),
		
		    SinDuplicados = Table.Distinct(Columnas)
		in
		    SinDuplicados
	lineageTag: 0cf28788-b80a-4e40-b8ce-c7b2230207d0
