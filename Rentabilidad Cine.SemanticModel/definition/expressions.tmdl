expression Revision_Candidatas_Puntuaciones =
		let
		    Origen = Revision_Sin_Puntuacion,
		
		    Combinadas = Table.NestedJoin(
		        Origen,
		        {"Clave_Alternativa"},
		        Mapa_Puntuaciones_Alternativas,
		        {"Clave_Alternativa"},
		        "Mapa_Puntuaciones_Alternativas",
		        JoinKind.LeftOuter
		    ),
		
		    Expandidas = Table.ExpandTableColumn(
		        Combinadas,
		        "Mapa_Puntuaciones_Alternativas",
		        {"Clave_Puntuacion_Original"},
		        {"Clave_Puntuacion_Original"}
		    ),
		
		    ConEstado = Table.AddColumn(
		        Expandidas,
		        "Estado_Candidata",
		        each
		            if [Clave_Puntuacion_Original] = null then
		                "Sin candidata"
		            else
		                "Con candidata",
		        type text
		    )
		in
		    ConEstado
