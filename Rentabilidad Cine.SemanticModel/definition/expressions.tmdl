expression Peliculas_Texto = ```
		let
		    // Los acentos ya se reparan en Peliculas_Revision, fila por fila.
		    Origen = Peliculas_Revision,
		
		    ConTituloNormalizado = Table.AddColumn(
		        Origen,
		        "Titulo_Normalizado",
		        each
		            if [Título] = null then
		                null
		            else
		                Text.Upper(Text.Trim(Text.Clean([Título])), "es-ES"),
		        type text
		    ),
		
		    ConClave = Table.AddColumn(
		        ConTituloNormalizado,
		        "Clave_Busqueda",
		        each
		            if [Titulo_Normalizado] = null or [Año de estreno] = null then
		                null
		            else
		                [Titulo_Normalizado]
		                & "|"
		                & Text.From([Año de estreno], "en-US"),
		        type text
		    )
		in
		    ConClave
		
		```
