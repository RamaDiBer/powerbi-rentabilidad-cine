	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Control_Asignaciones_Puntuaciones =
		let
		    Exactas = Table.SelectRows(
		        Peliculas_Integradas,
		        each [Estado_Puntuacion] <> null
		            and [Clave_Union_Puntuaciones] <> null
		    ),
		
		    ClavesExactas = Table.RenameColumns(
		        Table.SelectColumns(
		            Exactas,
		            {"Fila_Excel", "Clave_Union_Puntuaciones"}
		        ),
		        {{"Clave_Union_Puntuaciones", "Clave_Puntuacion"}}
		    ),
		
		    Candidatas = Table.SelectRows(
		        Revision_Candidatas_Puntuaciones,
		        each [Clave_Puntuacion_Original] <> null
		    ),
		
		    ClavesCandidatas = Table.RenameColumns(
		        Table.SelectColumns(
		            Candidatas,
		            {"Fila_Excel", "Clave_Puntuacion_Original"}
		        ),
		        {{"Clave_Puntuacion_Original", "Clave_Puntuacion"}}
		    ),
		
		    Asignaciones = Table.Combine(
		        {ClavesExactas, ClavesCandidatas}
		    ),
		
		    Agrupadas = Table.Group(
		        Asignaciones,
		        {"Clave_Puntuacion"},
		        {
		            {
		                "Cantidad_Filas_Base",
		                each List.Count(List.Distinct([Fila_Excel])),
		                Int64.Type
		            },
		            {
		                "Filas_Excel",
		                each Text.Combine(
		                    List.Transform(
		                        List.Distinct([Fila_Excel]),
		                        each Text.From(_)
		                    ),
		                    ", "
		                ),
		                type text
		            }
		        }
		    ),
		
		    Compartidas = Table.SelectRows(
		        Agrupadas,
		        each [Cantidad_Filas_Base] > 1
		    )
		in
		    Compartidas
	lineageTag: 91335ffc-2fab-4e81-bc96-82e668050f0e
	queryGroup: '4. Controles'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Control_Geografia =
		let
		    Origen = Table.SelectColumns(
		        Geografia_Revision,
		        {
		            "Clave_Busqueda",
		            "Paises_Produccion",
		            "Codigos_Pais_ISO"
		        }
		    ),
		
		    ConClave = Table.SelectRows(
		        Origen,
		        each [Clave_Busqueda] <> null
		            and [Clave_Busqueda] <> ""
		    ),
		
		    Agrupadas = Table.Group(
		        ConClave,
		        {"Clave_Busqueda"},
		        {
		            {
		                "Filas_origen",
		                each Table.RowCount(_),
		                Int64.Type
		            },
		            {
		                "Versiones_geografia",
		                each Table.RowCount(
		                    Table.Distinct(
		                        Table.SelectColumns(
		                            _,
		                            {
		                                "Paises_Produccion",
		                                "Codigos_Pais_ISO"
		                            }
		                        )
		                    )
		                ),
		                Int64.Type
		            }
		        }
		    ),
		
		    Control = #table(
		        {"Control", "Cantidad"},
		        {
		            {"Total de filas", Table.RowCount(Origen)},
		            {
		                "Filas sin clave",
		                Table.RowCount(Origen) - Table.RowCount(ConClave)
		            },
		            {"Claves distintas", Table.RowCount(Agrupadas)},
		            {
		                "Claves repetidas",
		                Table.RowCount(
		                    Table.SelectRows(
		                        Agrupadas,
		                        each [Filas_origen] > 1
		                    )
		                )
		            },
		            {
		                "Claves con datos geográficos diferentes",
		                Table.RowCount(
		                    Table.SelectRows(
		                        Agrupadas,
		                        each [Versiones_geografia] > 1
		                    )
		                )
		            }
		        }
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        Control,
		        {
		            {"Control", type text},
		            {"Cantidad", Int64.Type}
		        }
		    )
		in
		    Tipos
	lineageTag: a1a710c5-0b47-4ab0-8789-c94ec57f3048
	queryGroup: '4. Controles'

