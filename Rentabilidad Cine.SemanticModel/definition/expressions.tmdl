	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Oscars_Preparados =
		let
		    Origen = Csv.Document(
		        File.Contents(
		            Text.TrimEnd(Carpeta_Datos, "\") & "\oscars_1927_a_presente.csv"
		        ),
		        [
		            Delimiter = ";",
		            Columns = 1,
		            Encoding = 65001,
		            QuoteStyle = QuoteStyle.Csv
		        ]
		    ),
		
		    Separadas = Table.SplitColumn(
		        Origen,
		        "Column1",
		        Splitter.SplitTextByDelimiter(",", QuoteStyle.Csv),
		        List.Transform({1..12}, each "Campo" & Text.From(_)),
		        null,
		        ExtraValues.Error
		    ),
		
		    Encabezados = Table.PromoteHeaders(
		        Separadas,
		        [PromoteAllScalars = true]
		    ),
		
		    Columnas = Table.SelectColumns(
		        Encabezados,
		        {
		            "titulo",
		            "anio_estreno",
		            "anio_ceremonia_oscar",
		            "director",
		            "premios_oscars_ganados"
		        }
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        Columnas,
		        {
		            {"titulo", type text},
		            {"anio_estreno", Int64.Type},
		            {"anio_ceremonia_oscar", Int64.Type},
		            {"director", type text},
		            {"premios_oscars_ganados", type text}
		        }
		    ),
		
		    Nombres = Table.RenameColumns(
		        Tipos,
		        {
		            {"titulo", "Titulo_Oscar"},
		            {"anio_estreno", "Anio_Estreno"},
		            {"anio_ceremonia_oscar", "Anio_Ceremonia"},
		            {"director", "Director_Oscar"},
		            {"premios_oscars_ganados", "Premios_Originales"}
		        }
		    ),
		
		    ConFila = Table.AddIndexColumn(
		        Nombres, "Fila_Origen_Oscar", 2, 1, Int64.Type
		    ),
		
		    ConClave = Table.AddColumn(
		    ConFila,
		    "Clave_Busqueda",
		    each
		        let
		            Titulo = if [Titulo_Oscar] = null then null
		                else Text.Upper(
		                    Text.Trim(Text.Clean([Titulo_Oscar])), "es-ES"
		                ),
		            Director = if [Director_Oscar] = null then null
		                else Text.Upper(Text.Trim([Director_Oscar]), "es-ES"),
		            Anio = [Anio_Estreno],
		
		            TituloUnion =
		                if Titulo = "HUD EL MÁS SALVAJE ENTRE MIL"
		                    and Anio = 1963
		                    and Director = "MARTIN RITT"
		                then "HUD, EL MÁS SALVAJE ENTRE MIL"
		
		                else if Titulo = "HELLO DOLLY!"
		                    and Anio = 1969
		                    and Director = "GENE KELLY"
		                then "HELLO, DOLLY!"
		
		                else if Titulo = "NETWORK UN MUNDO IMPLACABLE"
		                    and Anio = 1976
		                    and Director = "SIDNEY LUMET"
		                then "NETWORK, UN MUNDO IMPLACABLE"
		
		                else Titulo
		        in
		            if TituloUnion = null or Anio = null then null
		            else TituloUnion & "|" & Text.From(Anio, "en-US"),
		    type text
		),
		
		    ConLista = Table.AddColumn(
		        ConClave,
		        "Premio_Original",
		        each
		            if [Premios_Originales] = null then
		                {}
		            else
		                List.Select(
		                    List.Transform(
		                        Text.Split([Premios_Originales], "|"),
		                        each Text.Trim(_)
		                    ),
		                    each _ <> ""
		                ),
		        type list
		    ),
		
		    ConEstado = Table.AddColumn(
		        ConLista,
		        "Estado_Dato_Premio",
		        each
		            if List.IsEmpty([Premio_Original]) then
		                "Sin detalle de premios"
		            else
		                "Con detalle de premios",
		        type text
		    ),
		
		    ConListaCompleta = Table.TransformColumns(
		        ConEstado,
		        {
		            {
		                "Premio_Original",
		                each if List.IsEmpty(_) then {null} else _,
		                type list
		            }
		        }
		    ),
		
		    PremiosEnFilas = Table.ExpandListColumn(
		        ConListaCompleta,
		        "Premio_Original"
		    ),
		
		    ConCategoria = Table.AddColumn(
		    PremiosEnFilas,
		    "Categoria_Original",
		    each
		        if [Premio_Original] = null then null
		        else
		            let
		                Texto = Text.Trim([Premio_Original]),
		                Recorrido = List.Accumulate(
		                    Text.ToList(Texto),
		                    [Nivel = 0, Posicion = 0, UltimaApertura = -1],
		                    (Estado, Caracter) =>
		                        [
		                            Nivel =
		                                Estado[Nivel]
		                                + (if Caracter = "(" then 1
		                                   else if Caracter = ")" then -1
		                                   else 0),
		                            Posicion = Estado[Posicion] + 1,
		                            UltimaApertura =
		                                if Caracter = "(" and Estado[Nivel] = 0
		                                then Estado[Posicion]
		                                else Estado[UltimaApertura]
		                        ]
		                )
		            in
		                if Recorrido[UltimaApertura] < 0 then Texto
		                else Text.Trim(
		                    Text.Start(Texto, Recorrido[UltimaApertura])
		                ),
		    type text
		),
		
		    MapaPeliculas = let
		    Columnas = Table.SelectColumns(
		        Peliculas_Texto,
		        {"Fila_Excel", "Clave_Busqueda"}
		    ),
		
		    SinNulos = Table.SelectRows(
		        Columnas,
		        each [Clave_Busqueda] <> null
		    ),
		
		    Agrupadas = Table.Group(
		        SinNulos,
		        {"Clave_Busqueda"},
		        {
		            {
		                "Cantidad",
		                each Table.RowCount(_),
		                Int64.Type
		            },
		            {
		                "Fila_Excel",
		                each
		                    if Table.RowCount(_) = 1 then
		                        [Fila_Excel]{0}
		                    else
		                        null,
		                Int64.Type
		            }
		        }
		    ),
		
		    Unicas = Table.SelectRows(
		        Agrupadas,
		        each [Cantidad] = 1
		    ),
		
		    Resultado = Table.RemoveColumns(
		        Unicas,
		        {"Cantidad"}
		    )
		in
		    Resultado,
		
		    Combinadas = Table.NestedJoin(
		        ConCategoria,
		        {"Clave_Busqueda"},
		        MapaPeliculas,
		        {"Clave_Busqueda"},
		        "Pelicula",
		        JoinKind.LeftOuter
		    ),
		
		    ConCantidad = Table.AddColumn(
		        Combinadas,
		        "Cantidad_Coincidencias",
		        each Table.RowCount([Pelicula]),
		        Int64.Type
		    ),
		
		    ConId = Table.AddColumn(
		        ConCantidad,
		        "Id_Pelicula",
		        each
		            if [Cantidad_Coincidencias] = 1 then
		                [Pelicula]{0}[Fila_Excel]
		            else
		                null,
		        Int64.Type
		    ),
		
		    ConEstadoUnion = Table.AddColumn(
		    ConId,
		    "Estado_Integracion_Oscar",
		    each
		        if [Cantidad_Coincidencias] = 0 then
		            "Sin asignación"
		        else if [Cantidad_Coincidencias] > 1 then
		            "Coincidencia ambigua"
		        else
		            let
		                ClaveOriginal =
		                    Text.Upper(
		                        Text.Trim(Text.Clean([Titulo_Oscar])), "es-ES"
		                    )
		                    & "|"
		                    & Text.From([Anio_Estreno], "en-US")
		            in
		                if [Clave_Busqueda] = ClaveOriginal then
		                    "Coincidencia exacta de clave"
		                else
		                    "Equivalencia de título revisada",
		    type text
		),
		
		    Resultado = Table.RemoveColumns(
		        ConEstadoUnion,
		        {"Pelicula"}
		    )
		in
		    Resultado
	lineageTag: 45e6cc04-74ff-492d-8c5c-7315c40577b7
	queryGroup: '1. Fuentes'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression IPC_Anual_USA =
		let
		    Origen = Csv.Document(
		        Web.Contents(
		            "https://fred.stlouisfed.org",
		            [
		                RelativePath = "graph/fredgraph.csv",
		                Query = [id = "CPIAUCNS"]
		            ]
		        ),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		
		    Encabezados = Table.PromoteHeaders(
		        Origen,
		        [PromoteAllScalars = true]
		    ),
		
		    Numeros = Table.TransformColumns(
		        Encabezados,
		        {
		            {
		                "CPIAUCNS",
		                each
		                    if _ = null or _ = "" or _ = "."
		                    then null
		                    else Number.FromText(_, "en-US"),
		                type number
		            }
		        }
		    ),
		
		    Fechas = Table.TransformColumnTypes(
		        Numeros,
		        {{"observation_date", type date}},
		        "en-US"
		    ),
		
		    ConAnio = Table.AddColumn(
		        Fechas,
		        "Anio",
		        each Date.Year([observation_date]),
		        Int64.Type
		    ),
		
		    Periodo = Table.SelectRows(ConAnio, each [Anio] <= 2025),
		
		    Anuales = Table.Group(
		        Periodo,
		        {"Anio"},
		        {
		            {"IPC_Anual", each List.Average([CPIAUCNS]), type number},
		            {"Meses", each List.NonNullCount([CPIAUCNS]), Int64.Type}
		        }
		    ),
		
		    Validados = Table.AddColumn(
		        Anuales,
		        "IPC_Validado",
		        each
		            if [Meses] = 12 or ([Anio] = 2025 and [Meses] = 11)
		            then [IPC_Anual]
		            else error "Revisar cobertura mensual del IPC.",
		        type number
		    ),
		
		    IPCBase = Validados{[Anio = 2025]}[IPC_Validado],
		
		    ConFactor = Table.AddColumn(
		        Validados,
		        "Factor_2025",
		        each IPCBase / [IPC_Validado],
		        type number
		    ),
		
		    Resultado = Table.SelectColumns(
		        ConFactor,
		        {"Anio", "IPC_Anual", "Meses", "Factor_2025"}
		    )
		in
		    Resultado
	lineageTag: 2b6c6474-553d-4736-a6d5-d4ed0e6372ca
	queryGroup: '1. Fuentes'

