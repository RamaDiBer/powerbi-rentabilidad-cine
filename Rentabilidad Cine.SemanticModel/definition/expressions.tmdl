	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Peliculas_Preparadas =
		let
		    Origen = Peliculas_Texto,
		
		    ClavesRepetidas = List.Buffer(
		        List.Distinct(
		            List.RemoveNulls(
		                Revision_Coincidencias[Clave_Busqueda]
		            )
		        )
		    ),
		
		    ConEstado = Table.AddColumn(
		        Origen,
		        "Estado_Coincidencia",
		        each
		            if [Clave_Busqueda] = null then
		                "Sin clave"
		            else if List.Contains(
		                ClavesRepetidas,
		                [Clave_Busqueda]
		            ) then
		                "Revisar identidad"
		            else
		                "Clave no repetida",
		        type text
		    )
		in
		    ConEstado
	lineageTag: ca5960cb-37c9-407a-b30e-766b5a7e897f
	queryGroup: '2. Preparación'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Puntuaciones_Agrupadas =
		let
		    Origen = Puntuaciones_Revision,
		
		    CamposPuntuacion = {
		        "Calificacion_TMDb",
		        "Total_Votos",
		        "Popularidad",
		        "Cantidad_Criticas",
		        "Criticas_Destacadas"
		    },
		
		    Agrupadas = Table.Group(
		        Origen,
		        {"Clave_Busqueda"},
		        {
		            {
		                "Filas_origen",
		                each Table.RowCount(_),
		                Int64.Type
		            },
		            {
		                "Versiones",
		                each Table.Distinct(
		                    Table.SelectColumns(_, CamposPuntuacion)
		                )
		            }
		        }
		    ),
		
		    ConCantidad = Table.AddColumn(
		        Agrupadas,
		        "Cantidad_versiones",
		        each Table.RowCount([Versiones]),
		        Int64.Type
		    ),
		
		    ConEstado = Table.AddColumn(
		        ConCantidad,
		        "Estado_Puntuacion",
		        each
		            if [Clave_Busqueda] = null then
		                "Sin clave"
		            else if [Cantidad_versiones] = 1 then
		                "Una versión"
		            else
		                "Revisar diferencias",
		        type text
		    )
		in
		    ConEstado
	lineageTag: 274d4c94-cf56-4b59-82bc-45ed24d5e49b
	queryGroup: '2. Preparación'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Puntuaciones_Preparadas =
		let
		    Origen = Puntuaciones_Agrupadas,
		
		    Campos = {
		        "Calificacion_TMDb",
		        "Total_Votos",
		        "Popularidad",
		        "Cantidad_Criticas",
		        "Criticas_Destacadas"
		    },
		
		    RegistroVacio = Record.FromList(
		        List.Repeat({null}, List.Count(Campos)),
		        Campos
		    ),
		
		    ConDatos = Table.AddColumn(
		        Origen,
		        "Datos_Puntuacion",
		        each
		            if [Estado_Puntuacion] = "Una versión"
		                and [Cantidad_versiones] = 1 then
		                [Versiones]{0}
		            else
		                RegistroVacio,
		        type record
		    ),
		
		    SinTablaAuxiliar = Table.RemoveColumns(
		        ConDatos,
		        {"Versiones"}
		    ),
		
		    Expandida = Table.ExpandRecordColumn(
		        SinTablaAuxiliar,
		        "Datos_Puntuacion",
		        Campos,
		        Campos
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        Expandida,
		        {
		            {"Calificacion_TMDb", type number},
		            {"Total_Votos", Int64.Type},
		            {"Popularidad", type number},
		            {"Cantidad_Criticas", Int64.Type},
		            {"Criticas_Destacadas", type text}
		        }
		    )
		in
		    Tipos
	lineageTag: e131b130-3fcb-4cdd-83f2-3ba0dace6149
