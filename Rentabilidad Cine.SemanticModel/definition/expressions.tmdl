expression Geografia_Revision =
		let
		    Origen = Excel.Workbook(
		        File.Contents(
		            Text.TrimEnd(Carpeta_Datos, "\") & "\Zona_Geografica_y_ROI.xlsx"
		        ),
		        null,
		        true
		    ),
		
		    Hoja = Origen{[Item="Sheet1", Kind="Sheet"]}[Data],
		
		    Encabezados = Table.PromoteHeaders(
		        Hoja,
		        [PromoteAllScalars = true]
		    ),
		
		    Columnas = Table.SelectColumns(
		        Encabezados,
		        {
		            "Título",
		            "Año de estreno",
		            "Paises_Produccion",
		            "Codigos_Pais_ISO"
		        }
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        Columnas,
		        {
		            {"Título", type text},
		            {"Año de estreno", Int64.Type},
		            {"Paises_Produccion", type text},
		            {"Codigos_Pais_ISO", type text}
		        }
		    ),
		
		    ConTituloNormalizado = Table.AddColumn(
		        Tipos,
		        "Titulo_Normalizado",
		        each
		            if [Título] = null then null
		            else Text.Upper(
		                Text.Trim(Text.Clean([Título])),
		                "es-ES"
		            ),
		        type text
		    ),
		
		    ConClave = Table.AddColumn(
		        ConTituloNormalizado,
		        "Clave_Busqueda",
		        each
		            if [Titulo_Normalizado] = null
		                or [Año de estreno] = null
		            then null
		            else [Titulo_Normalizado] & "|" &
		                Text.From([Año de estreno], "en-US"),
		        type text
		    )
		in
		    ConClave
