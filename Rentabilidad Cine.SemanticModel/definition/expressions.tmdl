expression Peliculas_Integradas =
		let
		    Origen = Peliculas_Preparadas,
		
		    CamposPuntuacion = {
		        "Estado_Puntuacion",
		        "Calificacion_TMDb",
		        "Total_Votos",
		        "Popularidad",
		        "Cantidad_Criticas",
		        "Criticas_Destacadas"
		    },
		
		    // Solo se unen las películas cuya clave no está repetida.
		    ConClaveUnion = Table.AddColumn(
		        Origen,
		        "Clave_Union_Puntuaciones",
		        each
		            if [Estado_Coincidencia] = "Clave no repetida"
		            then [Clave_Busqueda]
		            else null,
		        type text
		    ),
		
		    Combinadas = Table.NestedJoin(
		        ConClaveUnion,
		        {"Clave_Union_Puntuaciones"},
		        Puntuaciones_Preparadas,
		        {"Clave_Busqueda"},
		        "Puntuaciones_Preparadas",
		        JoinKind.LeftOuter
		    ),
		
		    Expandidas = Table.ExpandTableColumn(
		        Combinadas,
		        "Puntuaciones_Preparadas",
		        CamposPuntuacion,
		        CamposPuntuacion
		    ),
		
		    ConEstado = Table.AddColumn(
		        Expandidas,
		        "Estado_Integracion_Puntuaciones",
		        each
		            if [Estado_Coincidencia] = "Revisar identidad" then
		                "Identidad pendiente"
		            else if [Estado_Puntuacion] = null then
		                "Sin coincidencia"
		            else if [Estado_Puntuacion] = "Revisar diferencias" then
		                "Puntuaciones en conflicto"
		            else if [Calificacion_TMDb] = null then
		                "Sin calificación disponible"
		            else if [Total_Votos] = null or [Total_Votos] = 0 then
		                "Sin votos disponibles"
		            else
		                "Con calificación y votos",
		        type text
		    )
		in
		    ConEstado
	lineageTag: 25ca2f84-83fa-4232-aacd-db90a0f2c697
	queryGroup: '3. Integración'

