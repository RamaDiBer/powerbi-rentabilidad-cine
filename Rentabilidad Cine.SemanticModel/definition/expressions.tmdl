expression Control_Oscars =
		let
		    Origen = Oscars_Preparados,
		
		    Resumen = Table.Group(
		        Origen,
		        {"Estado_Integracion_Oscar"},
		        {
		            {
		                "Filas_Detalle",
		                each Table.RowCount(_),
		                Int64.Type
		            },
		            {
		                "Registros_Origen",
		                each List.Count(
		                    List.Distinct([Fila_Origen_Oscar])
		                ),
		                Int64.Type
		            },
		            {
		                "Peliculas_Vinculadas",
		                each List.Count(
		                    List.Distinct(
		                        List.RemoveNulls([Id_Pelicula])
		                    )
		                ),
		                Int64.Type
		            }
		        }
		    )
		in
		    Resumen
	lineageTag: d42367f7-3113-4117-bcb3-f1b9d0667edf
