	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Number

expression Control_Calidad =
		let
		    Datos = Peliculas_Texto,
		
		    Resumen = #table(
		        type table [Control = text, Cantidad = Int64.Type],
		        {
		            {
		                "Total de filas",
		                Table.RowCount(Datos)
		            },
		            {
		                "Filas con 10 campos originales",
		                Table.RowCount(
		                    Table.SelectRows(
		                        Datos,
		                        each [Campos_detectados] = 10
		                    )
		                )
		            },
		            {
		                "Filas con título reconstruido",
		                Table.RowCount(
		                    Table.SelectRows(
		                        Datos,
		                        each [Campos_detectados] > 10
		                    )
		                )
		            },
		            {
		                "Filas con campos insuficientes",
		                Table.RowCount(
		                    Table.SelectRows(
		                        Datos,
		                        each [Campos_detectados] < 10
		                    )
		                )
		            },
		            {
		                "Filas con errores en alguna columna",
		                Table.RowCount(
		                    Table.SelectRowsWithErrors(Datos)
		                )
		            }
		        }
		    )
		in
		    Resumen
	lineageTag: 3571b74b-18a5-4158-90c3-6beb1e02cd39
	queryGroup: '4. Controles'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Control_Integracion_Puntuaciones =
		let
		    Origen = Peliculas_Con_Puntuaciones,
		
		    Resumen = Table.Group(
		        Origen,
		        {"Estado_Integracion_Puntuaciones"},
		        {
		            {
		                "Cantidad_Peliculas",
		                each Table.RowCount(_),
		                Int64.Type
		            }
		        }
		    )
		in
		    Resumen
