	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Revision_Coincidencias =
		let
		    Origen = Peliculas_Texto,
		
		    Agrupadas = Table.Group(
		        Origen,
		        {"Clave_Busqueda"},
		        {
		            {"Cantidad", each Table.RowCount(_), Int64.Type},
		            {"Detalle", each _}
		        }
		    ),
		
		    Repetidas = Table.SelectRows(
		        Agrupadas,
		        each [Cantidad] > 1
		    ),
		
		    Resultado = Table.ExpandTableColumn(
		        Repetidas,
		        "Detalle",
		        {
		            "Fila_Excel",
		            "Título",
		            "Año de estreno",
		            "Director",
		            "Presupuesto_usd",
		            "Ingresos_usd"
		        }
		    )
		in
		    Resultado
