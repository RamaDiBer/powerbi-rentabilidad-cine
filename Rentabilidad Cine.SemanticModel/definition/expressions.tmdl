	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Peliculas_Con_Puntuaciones =
		let
		    Origen = Peliculas_Integradas,
		
		    CamposPuntuacion = {
		        "Estado_Puntuacion",
		        "Calificacion_TMDb",
		        "Total_Votos",
		        "Popularidad",
		        "Cantidad_Criticas",
		        "Criticas_Destacadas"
		    },
		
		    // Las puntuaciones recuperadas por clave alternativa llevan prefijo
		    // para no pisar las que vinieron por coincidencia exacta.
		    Prefijo = "Puntuaciones_Recuperadas.",
		    CamposRecuperados = {"Clave_Puntuacion_Original"} & CamposPuntuacion,
		
		    Combinadas = Table.NestedJoin(
		        Origen,
		        {"Fila_Excel"},
		        Puntuaciones_Recuperadas,
		        {"Fila_Excel"},
		        "Puntuaciones_Recuperadas",
		        JoinKind.LeftOuter
		    ),
		
		    Expandidas = Table.ExpandTableColumn(
		        Combinadas,
		        "Puntuaciones_Recuperadas",
		        CamposRecuperados,
		        List.Transform(CamposRecuperados, each Prefijo & _)
		    ),
		
		    ConMetodo = Table.AddColumn(
		        Expandidas,
		        "Metodo_Coincidencia_Puntuaciones",
		        each
		            if [Estado_Coincidencia] = "Revisar identidad" then
		                "Identidad pendiente"
		            else if [Estado_Puntuacion] <> null then
		                "Coincidencia exacta de clave"
		            else if [#"Puntuaciones_Recuperadas.Clave_Puntuacion_Original"] <> null then
		                "Normalización de separadores"
		            else
		                "Sin coincidencia",
		        type text
		    ),
		
		    // Elegimos la versión final de cada campo según el método de coincidencia.
		    ConDatosFinales = Table.AddColumn(
		        ConMetodo,
		        "Datos_Puntuacion_Final",
		        (Fila) =>
		            if Fila[Metodo_Coincidencia_Puntuaciones]
		                = "Normalización de separadores"
		            then
		                Record.FromList(
		                    List.Transform(
		                        CamposPuntuacion,
		                        (Campo) => Record.Field(Fila, Prefijo & Campo)
		                    ),
		                    CamposPuntuacion
		                )
		            else
		                Record.SelectFields(Fila, CamposPuntuacion),
		        type record
		    ),
		
		    // Quitamos las versiones anteriores y el estado previo,
		    // que se vuelve a calcular con los datos finales.
		    SinVersionesAnteriores = Table.RemoveColumns(
		        ConDatosFinales,
		        CamposPuntuacion
		            & List.Transform(CamposPuntuacion, each Prefijo & _)
		            & {"Estado_Integracion_Puntuaciones"}
		    ),
		
		    DatosFinales = Table.ExpandRecordColumn(
		        SinVersionesAnteriores,
		        "Datos_Puntuacion_Final",
		        CamposPuntuacion,
		        CamposPuntuacion
		    ),
		
		    ConEstado = Table.AddColumn(
		        DatosFinales,
		        "Estado_Integracion_Puntuaciones",
		        each
		            if [Metodo_Coincidencia_Puntuaciones] = "Identidad pendiente" then
		                "Identidad pendiente"
		            else if [Estado_Puntuacion] = null then
		                "Sin coincidencia"
		            else if [Estado_Puntuacion] = "Revisar diferencias" then
		                "Puntuaciones en conflicto"
		            else if [Calificacion_TMDb] = null then
		                "Sin calificación disponible"
		            else if [Total_Votos] = null or [Total_Votos] = 0 then
		                "Sin votos disponibles"
		            else
		                "Con calificación y votos",
		        type text
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        ConEstado,
		        {
		            {"Calificacion_TMDb", type number},
		            {"Popularidad", type number},
		            {"Total_Votos", Int64.Type},
		            {"Cantidad_Criticas", Int64.Type},
		            {"Criticas_Destacadas", type text},
		            {"Estado_Puntuacion", type text}
		        }
		    ),
		
		    Resultado = Table.SelectColumns(
		        Tipos,
		        {
		            "Fila_Excel",
		            "Título",
		            "Año de estreno",
		            "Género",
		            "Subgénero",
		            "Presupuesto_usd",
		            "Ingresos_usd",
		            "Director",
		            "Actores_principales",
		            "Estudios cinematográficos",
		            "Pósters",
		            "Campos_detectados",
		            "Estado_estructura",
		            "Registro_original",
		            "Titulo_Normalizado",
		            "Clave_Busqueda",
		            "Calificacion_TMDb",
		            "Total_Votos",
		            "Estado_Coincidencia",
		            "Clave_Union_Puntuaciones",
		            "Puntuaciones_Recuperadas.Clave_Puntuacion_Original",
		            "Metodo_Coincidencia_Puntuaciones",
		            "Estado_Puntuacion",
		            "Popularidad",
		            "Cantidad_Criticas",
		            "Criticas_Destacadas",
		            "Estado_Integracion_Puntuaciones"
		        }
		    )
		in
		    Resultado
	lineageTag: ea138fde-fe2a-44c4-8774-e68abcb1f238
	queryGroup: '3. Integración'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Peliculas_Con_Geografia =
		let
		    Origen = Peliculas_Con_Puntuaciones,
		
		    ConClave = Table.AddColumn(
		        Origen,
		        "Clave_Union_Geografia",
		        each
		            if [Estado_Coincidencia] = "Clave no repetida"
		            then [Clave_Busqueda]
		            else null,
		        type text
		    ),
		
		    Combinadas = Table.NestedJoin(
		        ConClave,
		        {"Clave_Union_Geografia"},
		        Geografia_Preparada,
		        {"Clave_Busqueda"},
		        "Datos_Geografia",
		        JoinKind.LeftOuter
		    ),
		
		    Expandidas = Table.ExpandTableColumn(
		        Combinadas,
		        "Datos_Geografia",
		        {
		            "Clave_Busqueda",
		            "Paises_Produccion",
		            "Codigos_Pais_ISO"
		        },
		        {
		            "Clave_Geografia_Encontrada",
		            "Paises_Produccion",
		            "Codigos_Pais_ISO"
		        }
		    ),
		
		    ConEstado = Table.AddColumn(
		        Expandidas,
		        "Estado_Integracion_Geografia",
		        each
		            if [Estado_Coincidencia] = "Revisar identidad"
		            then "Identidad pendiente"
		            else if [Clave_Union_Geografia] = null
		            then "Sin clave"
		            else if [Clave_Geografia_Encontrada] = null
		            then "Sin coincidencia"
		            else "Coincidencia exacta de clave",
		        type text
		    )
		in
		    ConEstado
	lineageTag: 18fbeb43-cd1d-42b9-b0fe-f8750bb8f639
	queryGroup: '3. Integración'

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Peliculas_Geografia_Final =
		let
		    Origen = Peliculas_Con_Geografia,
		
		    Campos = {
		        "Clave_Geografia_Encontrada",
		        "Paises_Produccion",
		        "Codigos_Pais_ISO",
		        "Estado_Integracion_Geografia"
		    },
		
		    ConClaveAlternativa = Table.AddColumn(
		        Origen,
		        "_ClaveAlternativaGeo",
		        each
		            if [Estado_Integracion_Geografia] = "Sin coincidencia"
		                and [Estado_Coincidencia] = "Clave no repetida"
		                and [Metodo_Coincidencia_Puntuaciones]
		                    = "Normalización de separadores"
		            then
		                [#"Puntuaciones_Recuperadas.Clave_Puntuacion_Original"]
		            else
		                null,
		        type text
		    ),
		
		    Combinadas = Table.NestedJoin(
		        ConClaveAlternativa,
		        {"_ClaveAlternativaGeo"},
		        Geografia_Preparada,
		        {"Clave_Busqueda"},
		        "_GeografiaAlternativa",
		        JoinKind.LeftOuter
		    ),
		
		    Expandidas = Table.ExpandTableColumn(
		        Combinadas,
		        "_GeografiaAlternativa",
		        {
		            "Clave_Busqueda",
		            "Paises_Produccion",
		            "Codigos_Pais_ISO"
		        },
		        {
		            "_ClaveRecuperada",
		            "_PaisesRecuperados",
		            "_CodigosRecuperados"
		        }
		    ),
		
		    ConDatosFinales = Table.AddColumn(
		        Expandidas,
		        "_DatosFinales",
		        each
		            if [_ClaveRecuperada] <> null then
		                [
		                    Clave_Geografia_Encontrada =
		                        [_ClaveRecuperada],
		                    Paises_Produccion =
		                        [_PaisesRecuperados],
		                    Codigos_Pais_ISO =
		                        [_CodigosRecuperados],
		                    Estado_Integracion_Geografia =
		                        "Normalización de separadores"
		                ]
		            else
		                Record.SelectFields(_, Campos),
		        type record
		    ),
		
		    SinAuxiliares = Table.RemoveColumns(
		        ConDatosFinales,
		        Campos & {
		            "_ClaveAlternativaGeo",
		            "_ClaveRecuperada",
		            "_PaisesRecuperados",
		            "_CodigosRecuperados"
		        }
		    ),
		
		    Resultado = Table.ExpandRecordColumn(
		        SinAuxiliares,
		        "_DatosFinales",
		        Campos,
		        Campos
		    ),
		
		    Tipos = Table.TransformColumnTypes(
		        Resultado,
		        List.Transform(Campos, each {_, type text})
		    ),
		    // Lista de países limpia, para armar el puente película-país.
		    ConListaPaises = Table.AddColumn(
		        Tipos,
		        "Lista_Paises_Produccion",
		        each
		            let
		                Texto = [Paises_Produccion],
		                Partes =
		                    if Texto = null then {}
		                    else Text.Split(Texto, ","),
		                Limpias = List.Transform(
		                    Partes,
		                    each Text.Upper(Text.Trim(Text.Clean(_)), "es-ES")
		                ),
		                Validas = List.Select(
		                    Limpias,
		                    each not List.Contains(
		                        {"", "N/A", "NO ENCONTRADA", "NO ENCONTRADA EN TMDB"},
		                        _
		                    )
		                )
		            in
		                List.Distinct(Validas),
		        type list
		    ),
		
		    ConEstadoPais = Table.AddColumn(
		        ConListaPaises,
		        "Estado_Dato_Pais",
		        each
		            if List.IsEmpty([Lista_Paises_Produccion])
		            then "Sin país informado"
		            else "Con país informado",
		        type text
		    )
		in
		    ConEstadoPais
	lineageTag: d0a6860d-68e5-4c75-87d5-db34cb05ff1a
	queryGroup: '3. Integración'

