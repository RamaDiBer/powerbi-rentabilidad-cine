expression Revision_Sin_Puntuacion =
		let
		    Origen = Peliculas_Integradas,
		
		    SinCoincidencia = Table.SelectRows(
		        Origen,
		        each [Estado_Integracion_Puntuaciones] = "Sin coincidencia"
		    ),
		
		    Columnas = Table.SelectColumns(
		        SinCoincidencia,
		        {"Fila_Excel", "Título", "Año de estreno", "Director", "Clave_Busqueda"}
		    ),
		
		    // Misma clave, pero cambiando comas y guiones por espacios.
		    ConClaveAlternativa = Table.AddColumn(
		        Columnas,
		        "Clave_Alternativa",
		        each
		            let
		                Titulo = Text.Upper(Text.Trim([Título]), "es-ES"),
		                Separadores = Text.Replace(
		                    Text.Replace(Titulo, ",", " "),
		                    "-", " "
		                ),
		                SinEspaciosExtra = Text.Combine(
		                    List.Select(Text.Split(Separadores, " "), each _ <> ""),
		                    " "
		                )
		            in
		                SinEspaciosExtra & "|" &
		                Text.From([Año de estreno], "en-US"),
		        type text
		    )
		in
		    ConClaveAlternativa
	lineageTag: fa220467-d05e-4c73-a684-081a94c38491
