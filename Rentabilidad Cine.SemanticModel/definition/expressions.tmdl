expression Puntuaciones_Recuperadas =
		let
		    Origen = Revision_Candidatas_Puntuaciones,
		
		    ConCandidata = Table.SelectRows(
		        Origen,
		        each [Estado_Candidata] = "Con candidata"
		    ),
		
		    Combinadas = Table.NestedJoin(
		        ConCandidata,
		        {"Clave_Puntuacion_Original"},
		        Puntuaciones_Preparadas,
		        {"Clave_Busqueda"},
		        "Puntuaciones_Preparadas",
		        JoinKind.LeftOuter
		    ),
		
		    CamposPuntuacion = {
		        "Estado_Puntuacion",
		        "Calificacion_TMDb",
		        "Total_Votos",
		        "Popularidad",
		        "Cantidad_Criticas",
		        "Criticas_Destacadas"
		    },
		
		    Expandidas = Table.ExpandTableColumn(
		        Combinadas,
		        "Puntuaciones_Preparadas",
		        CamposPuntuacion,
		        CamposPuntuacion
		    )
		in
		    Expandidas
