	annotation PBI_ResultType = Table

expression Revision_Oscars_Sin_Asignar =
		let
		    Origen = Oscars_Preparados,
		
		    SinAsignar = Table.SelectRows(
		        Origen,
		        each [Estado_Integracion_Oscar] = "Sin asignación"
		    ),
		
		    Columnas = Table.SelectColumns(
		        SinAsignar,
		        {
		            "Fila_Origen_Oscar",
		            "Titulo_Oscar",
		            "Anio_Estreno",
		            "Director_Oscar",
		            "Clave_Busqueda"
		        }
		    ),
		
		    UnaFilaPorRegistro = Table.Distinct(Columnas),
		
		    Ordenadas = Table.Sort(
		        UnaFilaPorRegistro,
		        {
		            {"Anio_Estreno", Order.Descending},
		            {"Titulo_Oscar", Order.Ascending}
		        }
		    )
		in
		    Ordenadas
	lineageTag: 1921b86e-c20d-40d6-82a1-98ec1fb6f9b0
	queryGroup: '4. Controles'

